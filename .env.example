# APP_URL: URL pública onde a aplicação está hospedada.
# Em produção (Vercel / Cloud Run), utilizada para sitemap, canonical e OG URLs.
APP_URL="http://localhost:3000"

# BLOB_STORE_ID & BLOB_READ_WRITE_TOKEN: Credenciais do Vercel Blob para upload de fotos, vídeos e documentos no painel.
# Configure nas variáveis de ambiente da Vercel ou no .env local para upload em nuvem.
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""

# GEMINI_API_KEY: Opcional (reservado ao ambiente).
GEMINI_API_KEY=""

# Configurações opcionais de sessão administrativa (sobrescrevem os padrões locais se definidos)
# ADMIN_EMAIL="admin@x.com"
# ADMIN_PASSWORD=""
# ADMIN_SESSION_SECRET=""
